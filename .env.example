# Copia este archivo como ".env" y ajusta los valores antes de usar en producción.

# Puerto en el que corre el servidor
PORT=3000

# Clave secreta para firmar las cookies de sesión del panel administrador.
# Genera una propia con: npm run generar-secret
SESSION_SECRET=

# Usuario del panel administrador (evita usar "admin").
ADMIN_USERNAME=

# Hash de la contraseña del panel administrador (NO se guarda la contraseña en texto plano).
# Genera tu propio hash con una contraseña fuerte (12+ caracteres):
#   npm run generar-hash -- "tu-contraseña-nueva"
ADMIN_PASSWORD_HASH=

# Ruta donde vivirá el panel administrador (no enlazada desde la página pública).
# Cámbiala por algo propio si quieres una capa extra de discreción.
ADMIN_PATH=/panel-kosecha

# ===== SUPABASE CONFIGURATION =====
# URL base del proyecto Supabase
SUPABASE_URL=

# Clave pública para acceso frontend (segura para compartir)
SUPABASE_ANON_KEY=

# Clave privada para servidor (NO compartir, solo en backend)
# Obtener de: Project Settings → API → "Secret keys"
SUPABASE_SERVICE_ROLE_KEY=
